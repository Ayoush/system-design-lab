# NANO — default profile. Smallest resource footprint, breaks fastest.
# Use: docker compose --project-directory . --env-file common/infra/profiles/nano.env -f ...
# Same ratios as production, just shrunk so a laptop can generate the failure
# in seconds instead of needing 1M real requests. See ROADMAP.md §4.2.

API_CPUS=0.25
API_MEM=256m
PG_CPUS=0.5
PG_MEM=256m
PG_MAX_CONNECTIONS=20
PG_SHARED_BUFFERS=8MB
PG_WORK_MEM=64kB
APP_POOL_SIZE=5
PGBOUNCER_POOL_SIZE=5
REDIS_MAXMEM=8mb
